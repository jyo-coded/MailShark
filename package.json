{
  "name": "mailshark",
  "version": "1.0.0",
  "private": true,
  "description": "MailShark: local-first phishing forensics and campaign tracing for webmail.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "watch": "node scripts/build.mjs --dev --watch",
    "icons": "node scripts/icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:ext": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "package": "node scripts/package.mjs",
    "export-features": "node scripts/export-features.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run lint:ext"
  },
  "dependencies": {
    "d3-force": "3.0.0",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "idb": "8.0.3",
    "jsqr": "1.4.0",
    "postal-mime": "3.0.0",
    "preact": "10.29.8",
    "tldts": "7.4.13"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/d3-force": "^3.0.10",
    "@types/firefox-webext-browser": "143.0.0",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "qrcode": "1.5.4",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "web-ext": "10.7.0"
  }
}
